{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "vite build",
    "dev:legacy-server": "tsx server/index.ts",
    "build:legacy-server": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start:legacy-server": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "APP_ENV=test tsx --test src/**/*.test.ts server/**/*.test.ts tests/integration/*.test.ts",
    "test:unit": "APP_ENV=test tsx --test src/domain/*.test.ts server/config/*.test.ts server/observability/*.test.ts",
    "test:integration": "APP_ENV=test tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "check:secrets": "! git grep -nEI '(AIza[0-9A-Za-z_-]{30,}|(api|secret)[_-]?key[[:space:]]*=[[:space:]]*[^$[:space:]]{12,})' -- ':!bun.lock' ':!package-lock.json'",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
